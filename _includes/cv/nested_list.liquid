<ul class="cv-list">
  {% for content in entry.contents %}
    <li class="cv-item">
      <span class="cv-item-title">{{ content.title }}</span>
      {% if content.items %}
        <ul class="cv-sublist">
          {% for subitem in content.items %}
            <li>{{ subitem }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </li>
  {% endfor %}
</ul>
