<ul class="cv-list">
  {% for content in entry.contents %}
    <li class="cv-item">
      <span class="cv-item-title">{{ content.title }}</span>{% if content.year %}, <em>{{ content.year }}</em>{% endif %}
      {% if content.institution %}<br><span class="cv-item-detail">{{ content.institution }}</span>{% endif %}
    </li>
  {% endfor %}
</ul>
